---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<main>
  <h1>Erode Cafe Guide</h1>
  <p>
    Honest, first-hand reviews of cafes and coffee shops in Erode, Tamil Nadu.
    Every cafe on this site is personally visited, with original photos and
    real notes on coffee, seating, prices, and atmosphere.
  </p>
  <h2>What you will find here</h2>
  <ul>
    <li>Cafes near Erode Bus Stand and Railway Station</li>
    <li>Aesthetic and student-friendly cafes</li>
    <li>Honest notes on coffee quality, price, and seating</li>
  </ul>
  <p>
    First reviews are coming soon. Check the <a href="/blog">Blog</a> for the latest posts.
  </p>
</main>
		</main>
		<Footer />
	</body>
</html>
